# Required for both CLI and server.
# Get one at https://openrouter.ai
OPENROUTER_API_KEY=sk-or-v1-replace-me

# Optional. Enables kev_lookup, cve_exploits, detection_rules, vulncheck_query.
# Without this the agent is docs-only.
VULNCHECK_API_TOKEN=

# Optional. Enables web_search and find_vendor_cves.
# Pricing: $5/1k requests with $5/month free credit (attribution required).
# https://api-dashboard.search.brave.com/
BRAVE_API_KEY=
